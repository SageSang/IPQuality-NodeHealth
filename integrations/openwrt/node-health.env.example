# Copy to /etc/local-socks/node-health.env and chmod 0600.
# URLs and credentials belong only in the private copy on OpenWrt.
RUNTIME_BUNDLE_URL='http://192.0.2.2:18887/api/v1/runtime-bundles/latest'
# Existing NAS http.api_token, stored only in this root-owned 0600 file.
# Use HTTPS or a trusted restricted LAN; do not put credentials in the URL.
RUNTIME_TOKEN_FILE='/etc/local-socks/runtime-token'
# Legacy SOURCE_URL/RANKING_URL are not consumed by this poller.
# Fill only after reviewing the producer, port plan and actual runtime profile.
APPROVED_NAMESPACE=''
APPROVED_SERVER_INSTANCE_ID=''
APPROVED_PORT_PLAN_VERSION=''
RUNTIME_PROFILE_PATH='/etc/local-socks/runtime-profile.yaml'
APPROVED_RUNTIME_PROFILE_HASH=''
# Only an explicitly reviewed first migration with binding changes sets this.
APPROVED_INITIAL_MAPPING_VERSION=''
MAP_MAX_AGE_SECONDS='129600'

WORK_DIR='/etc/local-socks'
CACHE_DIR='/etc/local-socks/cache/node-health'
RUNTIME_CONTROLLER='/etc/local-socks/runtime-controller.mjs'
CONVERT_RUNNER='/etc/local-socks/convert-ranking.mjs'
STABLE_CONVERTER='/etc/local-socks/convert-any-proxy-to-local-socks-stable.js'
NODE_BIN='/usr/bin/node'
FLOCK_BIN='flock'
NODE_PATH='/etc/local-socks/node_modules:/usr/lib/node_modules'
# Optional absolute module entry point when NODE_PATH discovery is unavailable.
JS_YAML_PATH=''
# Keep a private executable copy so restarting/updating OpenClash cannot kill
# local-socks through a shared clash_meta process identity.
MIHOMO_BIN='/etc/local-socks/bin/mihomo-local-socks'
SERVICE_SCRIPT='/etc/init.d/local-socks'
SERVICE_NAME='local-socks'
# Optional on Linux without ubus; PID must identify this exact core and -f path.
SERVICE_PID_FILE=''
CONFIG_PATH='/etc/local-socks/config.yaml'
START_PORT='62000'
CONFIG_OWNER='root:nogroup'
CONFIG_MODE='0640'
EXPORT_DIR='/root/local-socks'
ADVERTISE_HOST='192.0.2.4'
READINESS_ATTEMPTS='5'
READINESS_DELAY_SECONDS='2'
LISTENER_CONNECT_TIMEOUT_MS='1500'
LISTENER_CHECK_CONCURRENCY='64'

CURL_CONNECT_TIMEOUT='10'
CURL_MAX_TIME='120'
BACKOFF_BASE_SECONDS='900'
BACKOFF_MAX_SECONDS='21600'
