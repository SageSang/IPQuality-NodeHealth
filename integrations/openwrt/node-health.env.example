# Copy to /etc/local-socks/node-health.env and chmod 0600.
# URLs and credentials belong only in the private copy on OpenWrt.
RANKING_URL='http://192.0.2.2:18887/current.json'
# Pull the complete inventory; OpenWrt applies current.json as the strict local
# allow-list. Do not add a #fragment. The poller appends a version query.
SOURCE_URL='http://192.0.2.2:3001/download/collection/inventory?target=ClashMeta&noCache=true'
# Optional remote converter. When set, check-ranking downloads this JS into a
# temporary staging directory before applying a changed ranking version.
STABLE_CONVERTER_URL='https://raw.githubusercontent.com/SageSang/IPQuality-NodeHealth/main/integrations/local-socks/convert-any-proxy-to-local-socks-stable.js'

WORK_DIR='/etc/local-socks'
CACHE_DIR='/etc/local-socks/cache/node-health'
APPLY_COMMAND='/etc/local-socks/apply-ranking.sh'
CONVERT_RUNNER='/etc/local-socks/convert-ranking.mjs'
STABLE_CONVERTER='/etc/local-socks/convert-any-proxy-to-local-socks-stable.js'
NODE_BIN='/usr/bin/node'
NODE_PATH='/etc/local-socks/node_modules:/usr/lib/node_modules'
# Optional absolute module entry point when NODE_PATH discovery is unavailable.
JS_YAML_PATH=''
MIHOMO_BIN='/etc/openclash/core/clash_meta'
SERVICE_SCRIPT='/etc/init.d/local-socks'
CONFIG_PATH='/etc/local-socks/config.yaml'
START_PORT='62000'
CONFIG_OWNER='root:nogroup'
CONFIG_MODE='0640'
EXPORT_DIR='/root/local-socks'
ADVERTISE_HOST='192.0.2.4'
READINESS_ATTEMPTS='5'
READINESS_DELAY_SECONDS='2'
LISTENER_CONNECT_TIMEOUT_MS='1500'
LISTENER_CHECK_CONCURRENCY='64'

CURL_CONNECT_TIMEOUT='10'
CURL_MAX_TIME='120'
BACKOFF_BASE_SECONDS='900'
BACKOFF_MAX_SECONDS='21600'
